_G.ObterEsteiraDelta = function()
    local uName, dName = string.lower(localPlayer.Name), string.lower(localPlayer.DisplayName)
    local baseEncontrada = nil
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextMesh") then
            if string.find(string.lower(obj.Text), uName) or string.find(string.lower(obj.Text), dName) then
                baseEncontrada = obj:FindFirstAncestorOfClass("Model") or obj.Parent
                if baseEncontrada then break end
            end
        end
    end
    if baseEncontrada then
        for _, child in pairs(baseEncontrada:GetDescendants()) do
            if child:IsA("BasePart") and (string.find(string.lower(child.Name), "tread") or string.find(string.lower(child.Name), "convey") or string.find(string.lower(child.Name), "esteira")) then return child end
        end
        return baseEncontrada:FindFirstChild("Treadmill", true) or baseEncontrada:FindFirstChild("Conveyor", true) or baseEncontrada:FindFirstChild("Floor", true)
    end
    return nil
end

_G.ClicarBotaoDropDelta = function()
    local pGui = localPlayer:FindFirstChildOfClass("PlayerGui")
    if not pGui then return end
    for _, objeto in ipairs(pGui:GetDescendants()) do
        if objeto.Name == "DropHeldEgg" then
            local botao = objeto:FindFirstChild("Button")
            if botao then
                local conexoes = getconnections and getconnections(botao.MouseButton1Click)
                if conexoes and #conexoes > 0 then
                    for _, c in ipairs(conexoes) do c:Fire() end
                else
                    local conexoesAtivadas = getconnections and getconnections(botao.Activated)
                    if conexoesAtivadas then for _, c in ipairs(conexoesAtivadas) do c:Fire() end end
                end
                break
            end
        end
    end
end

_G.SpamColetaPromptNoChao = function()
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local startSpam = tick()
    while tick() - startSpam < 1.0 do
        for _, desc in pairs(workspace:GetDescendants()) do
            if desc:IsA("ProximityPrompt") then
                desc.HoldDuration = 0
                if desc.Parent and (desc.Parent:IsA("Model") or desc.Parent:IsA("BasePart")) then
                    if (root.Position - desc.Parent:GetPivot().Position).Magnitude <= desc.MaxActivationDistance then
                        fireproximityprompt(desc)
                    end
                end
            end
        end
        game:GetService("RunService").Heartbeat:Wait()
    end
end
