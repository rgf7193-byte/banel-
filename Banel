local function getScaleMultiplier(scale)
	local n13 = tonumber(scale) or 1
	if n13 <= 5 then return n13 ^ 1.85 end
	return (n13 / 5) ^ 1.2 * 19.637875755794113
end

_G.DeltaGetEggData = function(record)
	local currentAssets = _G.DeltaAssets or Assets
	if not currentAssets or not currentAssets.Directory then return nil end
	local cfg = currentAssets.Directory[record.AssetCategory]
	if not cfg then return nil end
	
	local baseRate = tonumber(cfg.EarningRate) or 0
	local scale = tonumber(record.AssetScale) or 1
	local mult = 1
	
	local currentMutations = _G.DeltaMutations or Mutations
	if record.Mutations and #record.Mutations > 0 and currentMutations then
		local earningsFor = currentMutations.EarningsFor
		if type(earningsFor) == "function" then
			local ok, result = pcall(earningsFor, record.Mutations)
			if ok then mult = tonumber(result) or 1 end
		end
	end
	
	local totalGen = baseRate * getScaleMultiplier(scale) * mult
	local rarityName = cfg.Rarity and (cfg.Rarity.DisplayName or cfg.Rarity.Name) or "Common"
	local rarityColor = (_G.DeltaDefaultRarities or {})[string.lower(rarityName)] or Color3.fromRGB(255, 255, 255)
	
	return {
		Uid = record.Uid,
		Category = record.AssetCategory,
		Name = cfg.DisplayName or record.AssetCategory,
		Generation = math.round(totalGen),
		Position = record.BottomCFrame.Position,
		RarityName = string.upper(rarityName),
		RarityColor = rarityColor
	}
end

