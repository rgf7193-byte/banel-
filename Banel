_G.DeltaFormatNumber = function(val)
	local n = tonumber(val) or 0
	if math.abs(n) >= 1e12 then return string.format("%.2fT", n/1e12)
	elseif math.abs(n) >= 1e9 then return string.format("%.2fB", n/1e9)
	elseif math.abs(n) >= 1e6 then return string.format("%.2fM", n/1e6)
	elseif math.abs(n) >= 1000 then return string.format("%.2fK", n/1000)
	end
	return tostring(math.floor(n + 0.5))
end

