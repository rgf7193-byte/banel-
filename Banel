local function IniciarVooFracionadoAutomatico(coordAlvoBicho)
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    local oldHumanoid = character:WaitForChild("Humanoid")
    local voando = true
    local visualElements = {}
    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Clothing") or obj:IsA("BodyColors") or obj:IsA("ShirtGraphic") then visualElements[#visualElements + 1] = obj:Clone() end
    end
    local humanoidOriginal = oldHumanoid
    humanoidOriginal.Parent = nil 
    local fakeHumanoid = Instance.new("Humanoid")
    fakeHumanoid.Name = "Humanoid"
    fakeHumanoid.Parent = character
    for _, obj in ipairs(visualElements) do if not character:FindFirstChild(obj.Name) then obj.Parent = character end end
    local targetCFrame = rootPart.CFrame
    local conexaoTrava
    conexaoTrava = RunService.Heartbeat:Connect(function()
        if not voando then if conexaoTrava then conexaoTrava:Disconnect() end return end
        if rootPart and rootPart.Parent then rootPart.CFrame = targetCFrame rootPart.AssemblyLinearVelocity = Vector3.zero rootPart.AssemblyAngularVelocity = Vector3.zero fakeHumanoid.MaxHealth = math.huge fakeHumanoid.Health = math.huge end
    end)
    while (coordAlvoBicho - Vector3.new(targetCFrame.Position.X, coordAlvoBicho.Y, targetCFrame.Position.Z)).Magnitude > 10 do
        local posSubida = targetCFrame.Position + Vector3.new(0, alturaSeguraVoo, 0)
        local tempoSubida = (posSubida - targetCFrame.Position).Magnitude / 500
        local startSubida = tick()
        local startPosSubida = targetCFrame.Position
        while tick() - startSubida < tempoSubida do targetCFrame = CFrame.new(startPosSubida:Lerp(posSubida, math.clamp((tick() - startSubida) / tempoSubida, 0, 1))) * targetCFrame.Rotation task.wait() end
        targetCFrame = CFrame.new(posSubida) * targetCFrame.Rotation
        local direcaoAlvo = (coordAlvoBicho - Vector3.new(targetCFrame.Position.X, coordAlvoBicho.Y, targetCFrame.Position.Z)).Unit
        local distanciaRestante = (coordAlvoBicho - Vector3.new(targetCFrame.Position.X, coordAlvoBicho.Y, targetCFrame.Position.Z)).Magnitude
        local posAlvoNoAr = targetCFrame.Position + (direcaoAlvo * math.min(distanciaAvancoEtapa, distanciaRestante))
        local tempoCorrida = (posAlvoNoAr - targetCFrame.Position).Magnitude / velocidadeFixaVoo
        local startCorrida = tick()
        local startPosCorrida = targetCFrame.Position
        while tick() - startCorrida < tempoCorrida do targetCFrame = CFrame.new(startPosCorrida:Lerp(posAlvoNoAr, math.clamp((tick() - startCorrida) / tempoCorrida, 0, 1))) * targetCFrame.Rotation RunService.Heartbeat:Wait() end
        targetCFrame = CFrame.new(posAlvoNoAr) * targetCFrame.Rotation
        targetCFrame = CFrame.new(Vector3.new(targetCFrame.Position.X, coordAlvoBicho.Y, targetCFrame.Position.Z)) * targetCFrame.Rotation
        rootPart.CFrame = targetCFrame
        task.wait(0.5)
        if type(_G.ClicarBotaoDropDelta) == "function" then _G.ClicarBotaoDropDelta() end
        task.wait(1.5)
        if type(_G.SpamColetaPromptNoChao) == "function" then _G.SpamColetaPromptNoChao() end
    end
    local posSubidaFuga = targetCFrame.Position + Vector3.new(0, alturaSeguraVoo, 0)
    local tempoSubidaFuga = (posSubidaFuga - targetCFrame.Position).Magnitude / 500
    local startSubidaFuga = tick()
    local startPosSubidaFuga = targetCFrame.Position
    while tick() - startSubidaFuga < tempoSubidaFuga do targetCFrame = CFrame.new(startPosSubidaFuga:Lerp(posSubidaFuga, math.clamp((tick() - startSubidaFuga) / tempoSubidaFuga, 0, 1))) * targetCFrame.Rotation task.wait() end
